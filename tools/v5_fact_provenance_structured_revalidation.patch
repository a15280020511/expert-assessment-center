+def _cjk_ngrams(value: str, size: int) -> set[str]:
+    rendered = re.sub(r"[^0-9A-Za-z\u4e00-\u9fff]+", "", str(value or "")).casefold()
+    return {
+        rendered[index : index + size]
+        for index in range(max(0, len(rendered) - size + 1))
+    }
+
