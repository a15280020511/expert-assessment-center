{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a15280020511/expert-assessment-center/open-model-market/execution-ticket.schema.json",
  "title": "V5 Dynamic Expert DAG Execution Ticket",
  "description": "Execution contract for the GitHub-owned V5 dynamic expert DAG. The approved budget is a hard total paid-call ceiling that includes initial, retry, and replacement calls. GPTs submits and retrieves; GitHub owns planning, model and Provider selection, execution, synthesis, and deterministic acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "route", "task", "approved_budget"],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "objective": {
      "description": "Execution and delivery metadata for the GPTs/GitHub control plane. It is stored for audit but is not sent to experts or used for task classification. Put substantive goals in task.question and task.requirements.",
      "type": "string",
      "maxLength": 5000
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline_id", "stage_id"],
      "properties": {
        "pipeline_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
        },
        "stage_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
        },
        "sequence_reason": {"type": "string", "maxLength": 2000},
        "upstream_refs": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["center", "task_id", "file", "sha256"],
            "properties": {
              "center": {"enum": ["api", "compute", "expert", "user", "public_source"]},
              "task_id": {"type": "string", "maxLength": 128},
              "issue_number": {"type": "integer", "minimum": 1},
              "run_id": {"type": "integer", "minimum": 1},
              "artifact_id": {"type": "integer", "minimum": 1},
              "file": {"type": "string", "maxLength": 500},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "observed_at": {"type": "string", "maxLength": 100}
            }
          }
        }
      }
    },
    "route": {"const": "expert-team"},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question"],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "requirements": {
          "description": "Substantive requirements sent to the dynamic nodes. GitHub run, Job, Artifact, and acceptance checks do not belong here.",
          "type": "array",
          "maxItems": 20,
          "items": {"type": "string", "maxLength": 2000}
        },
        "language": {"type": "string", "maxLength": 64}
      }
    },
    "execution_acceptance": {
      "description": "Deterministic GitHub-side acceptance checks. These labels are stored with the ticket but are not sent to experts as substantive analysis instructions.",
      "type": "array",
      "maxItems": 40,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "note": {"type": "string", "maxLength": 5000}
          }
        },
        {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_level": {"type": "string", "maxLength": 5000},
              "source": {"type": "string", "maxLength": 5000},
              "url": {"type": "string", "maxLength": 5000},
              "note": {"type": "string", "maxLength": 5000},
              "center": {"type": "string", "enum": ["api", "compute", "expert", "gpts", "external"]},
              "run_id": {"type": "string", "pattern": "^[0-9]{1,32}$"},
              "artifact_id": {"type": "string", "pattern": "^[0-9]{1,32}$"},
              "file": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\\\]+$"
              },
              "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
              "observed_at": {"type": "string", "format": "date-time", "maxLength": 64}
            }
          }
        }
      ]
    },
    "approved_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calls", "maximum_recovery_calls", "cost_policy"],
      "properties": {
        "calls": {
          "description": "Hard ceiling for all paid model calls combined: initial calls + retries + replacements. The runtime must not silently increase this value.",
          "type": "integer",
          "minimum": 4,
          "maximum": 16
        },
        "maximum_recovery_calls": {
          "description": "Recovery calls reserved inside, not in addition to, approved_budget.calls. Production currently uses replacements and no same-endpoint retries.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "cost_policy": {
          "description": "No fixed dollar ceiling, but anomalous costs are stopped by task, estimate-deviation, and account-period guards.",
          "const": "unbounded_with_anomaly_guard"
        },
        "cost_anomaly_usd": {
          "description": "Optional task-level anomaly stop. It is not a spending target and must be enforced before any call that could cross it.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        }
      }
    },
    "quality_tier": {
      "description": "User cost/quality preference. Value remains the default and keeps price-performance first.",
      "type": "string",
      "enum": ["budget", "value", "quality"],
      "default": "value"
    },
    "private_output": {
      "description": "Private delivery is not implemented for this public repository. Omit this field or set it to false.",
      "const": false,
      "default": false
    }
  }
}
