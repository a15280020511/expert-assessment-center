{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/a15280020511/expert-assessment-center/open-model-market/execution-ticket.schema.json",
  "title": "Governance-Selected Expert Execution Ticket",
  "description": "The governance center owns task decomposition, model and Provider selection, expert roles, recovery routes and the immutable proposal. The expert center validates and executes only; local catalog access, ranking, substitution and fallback are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "route",
    "task",
    "approved_budget",
    "governance_selection"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "objective": {
      "type": "string",
      "maxLength": 5000
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline_id", "stage_id"],
      "properties": {
        "pipeline_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
        },
        "stage_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,63}$"
        },
        "sequence_reason": {
          "type": "string",
          "maxLength": 2000
        },
        "upstream_refs": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["center", "task_id", "file", "sha256"],
            "properties": {
              "center": {
                "enum": ["api", "compute", "expert", "user", "public_source"]
              },
              "task_id": {"type": "string", "maxLength": 128},
              "issue_number": {"type": "integer", "minimum": 1},
              "run_id": {"type": "integer", "minimum": 1},
              "artifact_id": {"type": "integer", "minimum": 1},
              "file": {"type": "string", "maxLength": 500},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "observed_at": {"type": "string", "maxLength": 100}
            }
          }
        }
      }
    },
    "route": {
      "const": "expert-team"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question"],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "requirements": {
          "type": "array",
          "maxItems": 20,
          "items": {"type": "string", "maxLength": 2000}
        },
        "language": {"type": "string", "maxLength": 64}
      }
    },
    "execution_acceptance": {
      "type": "array",
      "maxItems": 40,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "note": {"type": "string", "maxLength": 5000}
          }
        },
        {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_level": {"type": "string", "maxLength": 5000},
              "source": {"type": "string", "maxLength": 5000},
              "url": {"type": "string", "maxLength": 5000},
              "note": {"type": "string", "maxLength": 5000},
              "center": {
                "type": "string",
                "enum": ["api", "compute", "expert", "gpts", "external"]
              },
              "run_id": {"type": "string", "pattern": "^[0-9]{1,32}$"},
              "artifact_id": {"type": "string", "pattern": "^[0-9]{1,32}$"},
              "file": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\\\]+$"
              },
              "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
              "observed_at": {"type": "string", "format": "date-time", "maxLength": 64}
            }
          }
        }
      ]
    },
    "approved_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calls", "maximum_recovery_calls", "cost_policy"],
      "properties": {
        "calls": {"type": "integer", "minimum": 4, "maximum": 16},
        "maximum_recovery_calls": {"type": "integer", "minimum": 0, "maximum": 4},
        "cost_policy": {
          "enum": ["prompt_led_soft_governance", "unbounded_with_anomaly_guard"]
        },
        "cost_anomaly_usd": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "governance_selection": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "status",
        "selection_authority",
        "source_repository",
        "task_text",
        "task_sha256",
        "approved_total_calls",
        "approved_recovery_calls",
        "selected_expert_count",
        "task_envelope",
        "catalog",
        "catalog_sha256",
        "proposal",
        "proposal_sha256",
        "model_calls",
        "expert_center_selection_allowed",
        "expert_center_catalog_fetch_allowed",
        "local_fallback_allowed",
        "plan_sha256"
      ],
      "properties": {
        "schema_version": {"const": "governance-expert-model-selection-v1"},
        "status": {"const": "PASS"},
        "selection_authority": {"const": "decision-system-governance"},
        "source_repository": {"const": "a15280020511/decision-system-governance"},
        "task_text": {"type": "string", "minLength": 1, "maxLength": 100000},
        "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approved_total_calls": {"type": "integer", "minimum": 4, "maximum": 16},
        "approved_recovery_calls": {"type": "integer", "minimum": 0, "maximum": 4},
        "selected_expert_count": {"type": "integer", "minimum": 3, "maximum": 6},
        "task_envelope": {"type": "object"},
        "catalog": {"type": "object"},
        "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "proposal": {"type": "object"},
        "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_calls": {"const": 0},
        "expert_center_selection_allowed": {"const": false},
        "expert_center_catalog_fetch_allowed": {"const": false},
        "local_fallback_allowed": {"const": false},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "private_output": {
      "const": false,
      "default": false
    }
  }
}
