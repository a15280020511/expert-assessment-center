{
  "schema_version": "v5-team-policy-2",
  "pattern": "task-derived-dynamic-execution-graph",
  "constitution": {
    "task_independent": true,
    "scenario_specific_production_branches_forbidden": true,
    "all_computable_decisions_dynamic": true,
    "dynamic_variables": [
      "task interpretation breadth",
      "atomic work graph",
      "node count",
      "professional capabilities",
      "roles",
      "models",
      "model companies",
      "provider endpoints",
      "reasoning depth",
      "prompt modules",
      "output contracts",
      "candidate search width",
      "recovery allocation",
      "quality thresholds",
      "objective weights",
      "delivery coverage"
    ],
    "platform_safety_limits_are_not_solver_preferences": true,
    "fixed_model_score_weight_tuples_forbidden": true,
    "fixed_role_or_seat_count_forbidden": true,
    "fixed_interpretation_count_forbidden": true,
    "same_company_across_distinct_nodes_forbidden": true,
    "all_actual_calls_in_company_audit": true,
    "failed_calls_in_company_audit": true,
    "external_tools_allowed": false,
    "provider_fallback_allowed": false,
    "cross_task_history_allowed": false,
    "explicit_user_denial_overrides_permission": true,
    "degraded_delivery_default": "denied",
    "fact_truth_must_not_be_inferred_from_structure": true,
    "unsupported_precise_quantities_fail_closed": true,
    "structured_task_constraints_required": true,
    "checked_out_execution_sha_is_authoritative": true,
    "complete_audit_before_publication": true,
    "independent_acceptance_recomputes_from_primitive_evidence": true,
    "fail_closed": true
  },
  "capability_vocabulary": [
    {
      "key": "primary_analysis",
      "description": "建立问题框架、识别关键变量、完成必要分析与计算。",
      "binding_seat": false
    },
    {
      "key": "independent_verification",
      "description": "使用不同方法或相邻专业独立验证关键结论。",
      "binding_seat": false
    },
    {
      "key": "adversarial_reasoning",
      "description": "寻找反例、失败条件、证据缺口、隐藏假设和最坏情景。",
      "binding_seat": false
    },
    {
      "key": "synthesis",
      "description": "按任务输出合同综合可交付结论。",
      "binding_seat": false
    }
  ],
  "capability_vocabulary_policy": {
    "templates_are_nonbinding": true,
    "solver_may_select_zero_one_or_multiple_instances": true,
    "solver_may_create_other_task_derived_capabilities": true,
    "templates_must_not_determine_node_count": true
  },
