{
  "runtime_version": "v6-governed-roster-networkx-1",
  "catalog": {
    "sorts": [
      "intelligence-high-to-low",
      "pricing-low-to-high"
    ],
    "maximum_models": 150,
    "minimum_context_length": 8192,
    "selection_authority": "decision-system-governance",
    "selection_objective": "lowest-estimated-task-cost-distinct-companies",
    "local_scoring_allowed": false,
    "optimizer_allowed": false
  },
  "governance": {
    "roster_schema": "governed-expert-roster-v1",
    "governance_model_calls": 0,
    "claude_mechanism_enabled": false,
    "claude_red_team_calls": 0,
    "gpt_planning_calls": 0,
    "gpt_synthesis_calls": 0,
    "company_uniqueness": "task-global-all-different",
    "model_loop_allowed": false,
    "cross_task_history_used": false
  },
  "orchestration": {
    "library": "networkx==3.6.1",
    "graph_type": "networkx.DiGraph",
    "stage_algorithm": "networkx.topological_generations",
    "hidden_work_generation_allowed": false,
    "agent_framework_allowed": false
  },
  "execution": {
    "max_completion_tokens_source": "governance-roster-task-cost-profile",
    "reasoning_effort": "medium",
    "temperature": 0.0,
    "catalog_timeout_seconds": 30,
    "catalog_max_retries": 1,
    "model_timeout_seconds": 240,
    "model_max_retries": 0,
    "maximum_recovery_calls": 4,
    "parallel_workers": 4,
    "tools_allowed": false
  },
  "provider": {
    "zdr_required_for_all_models": true,
    "allow_fallbacks": false,
    "require_parameters": true,
    "explicit_provider_lock_required": true,
    "model_identity_substitution_allowed": false
  }
}
