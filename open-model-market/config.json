{
  "catalog": {
    "sorts": [
      "most-popular",
      "intelligence-high-to-low"
    ],
    "maximum_models": 50,
    "minimum_context_length": 16384,
    "popularity_period": "week",
    "selection_authority": "expert-center-ortools-from-governance-top50",
    "local_scoring_allowed": true,
    "optimizer_allowed": true
  },
  "governance": {
    "gpt_model": "~openai/gpt-latest",
    "claude_model": "~anthropic/claude-opus-latest",
    "claude_red_team_calls": 0,
    "claude_advisory_only": false,
    "claude_gatekeeping_allowed": false,
    "gpt_synthesis_calls": 0,
    "governance_calls": 0,
    "model_loop_allowed": false
  },
  "execution": {
    "max_completion_tokens": 10000,
    "reasoning_effort": "low",
    "temperature": 0.0,
    "catalog_timeout_seconds": 30,
    "catalog_max_retries": 1,
    "model_timeout_seconds": 240,
    "maximum_replacements": 4,
    "parallel_workers": 4
  },
  "provider": {
    "allow_fallbacks": true,
    "require_parameters": true,
    "explicit_provider_lock_required": true,
    "same_model_qualified_fallback_only": true,
    "fallback_scope": "audited-qualified-provider-whitelist"
  }
}
