{
  "schema_version": "v5-constitutional-policy-4",
  "authority": "CONSTITUTION.md",
  "fail_closed": true,
  "free_first_testing": {
    "required_order": [
      "zero_call_deterministic_validation",
      "zero_cost_free_model_canary",
      "explicitly_authorized_paid_acceptance_or_production"
    ],
    "free_model_required_before_paid": true,
    "free_model_actual_cost_usd": 0.0,
    "paid_models_allowed_for": [
      "formal_production_execution",
      "explicitly_authorized_final_paid_acceptance"
    ],
    "automatic_paid_retry_allowed": false,
    "free_evidence_can_qualify_formal_model_identity": false,
    "free_evidence_can_move_production": false
  },
  "expert_company_diversity": {
    "scope": "task_global_initial_and_recovery_experts",
    "constraint": "all_different",
    "provider_can_override_company": false,
    "reserved_governance_companies": [
      "openai",
      "anthropic"
    ],
    "pre_execution_validation_required": true,
    "post_execution_actual_success_audit_required": true,
    "duplicate_company_action": "fail_closed"
  },
  "dynamic_task_matching": {
    "required": true,
    "planner": "gpt_latest_single_pass",
    "recomputed_from_current_task": true,
    "cross_task_history_allowed": false,
    "dynamically_determined": [
      "work_items",
      "dependency_graph",
      "expert_count",
      "expert_roles",
      "expert_functions",
      "execution_stages",
      "final_nodes",
      "model",
      "provider",
      "reasoning_effort",
      "output_capacity_advisory",
      "recovery_candidates"
    ],
    "live_complete_endpoint_catalog_required": true,
    "fixed_expert_slots_allowed": false,
    "fixed_expert_count_allowed": false,
    "fixed_roles_allowed": false,
    "fixed_model_combinations_allowed": false,
    "fixed_provider_routes_allowed": false,
    "fixed_parameter_tiers_allowed": false,
    "keyword_routing_allowed": false,
    "domain_hardcoding_allowed": false,
    "local_scoring_or_optimizer_selection_allowed": false,
    "deterministic_validator_can_redesign_team": false,
    "invalid_dynamic_plan_action": "fail_closed"
  },
  "tool_prohibition": {
    "scope": [
      "gpt_proposal",
      "claude_red_team",
      "gpt_synthesis",
      "expert_execution",
      "expert_recovery"
    ],
    "external_tools_allowed": false,
    "web_browsing_allowed": false,
    "mcp_or_plugin_allowed": false,
    "code_or_shell_execution_allowed": false,
    "database_or_file_lookup_allowed": false,
    "connector_or_external_api_allowed": false,
    "request_tool_fields_allowed": false,
    "allowed_inputs": [
      "current_task_ticket",
      "provided_evidence_bundle",
      "current_model_endpoint_catalog",
      "legal_prior_outputs_within_same_task"
    ],
    "external_fact_collection_allowed": false,
    "violation_action": "fail_closed",
    "request_and_response_boundary_required": true,
    "response_tool_calls_allowed": false,
    "online_or_router_models_allowed": false,
    "arbitrary_network_egress_allowed": false,
    "model_plane_network_allowlist": [
      "openrouter.ai"
    ],
    "control_plane_network_allowlist": [
      "api.github.com"
    ],
    "network_violation_action": "fail_closed_without_recovery"
  },
  "resource_governance": {
    "mode": "prompt_led_soft_governance",
    "applies_to": [
      "gpt_proposal",
      "claude_red_team",
      "gpt_synthesis",
      "expert_execution",
      "expert_recovery"
    ],
    "local_token_ceiling_allowed": false,
    "local_reasoning_token_ceiling_allowed": false,
    "estimated_cost_can_reject_or_stop": false,
    "actual_cost_can_invalidate_valid_output": false,
    "provider_native_capacity_is_compatibility_boundary": true,
    "cost_and_token_usage_must_be_audited": true,
    "soft_prompt_requirements": [
      "complete_the_task_contract_first",
      "conclusion_first",
      "evidence_first",
      "high_information_density",
      "remove_repetition",
      "avoid_irrelevant_expansion",
      "never_omit_required_content_to_save_tokens"
    ],
    "operational_safety_limits_preserved": [
      "single_task_discipline",
      "fixed_governance_chain",
      "finite_retry",
      "timeout",
      "no_model_loop",
      "no_tools",
      "provider_lock"
    ]
  },
  "production_promotion": {
    "requires_zero_cost_ci": true,
    "requires_zero_cost_free_canary": true,
    "requires_explicit_paid_acceptance": true,
    "requires_independent_artifact_revalidation": true,
    "requires_run_sha_artifact_digest_binding": true,
    "automatic_merge_allowed": false,
    "automatic_production_ref_move_allowed": false
  },
  "network_isolation": {
    "arbitrary_egress_allowed": false,
    "model_plane_hosts": [
      "openrouter.ai"
    ],
    "control_plane_hosts": [
      "api.github.com"
    ],
    "model_access_to_network_allowed": false,
    "data_collection_or_web_search_allowed": false,
    "url_allowlist_enforced_before_request": true
  }
}
